      <div class="info">

        <strong>Importante:</strong>

        o estoque inicial configurado aqui é usado

        para iniciar um novo dia. Os dias que já possuem

        registros guardam seu próprio estoque inicial,

        portanto alterar este valor não modifica o histórico.

      </div>

    </main>

  `;

}

/* ============================================================

   MODAL PRODUTO

============================================================ */

function renderModal(){

  const p=

    state.modal;

  const editar=

    !!p.id;

  return`

    <div class="modal-bg">

      <div class="modal">

        <h3 style="margin-top:0">

          ${

            editar

            ?"Editar produto"

            :"Adicionar produto"

          }

        </h3>

        <form id="form-produto">

          <input

            type="hidden"

            name="id"

            value="${p.id||""}">

          <div class="form-grid">

            <div class="field">

              <label class="label">

                Nome

              </label>

              <input

                class="input"

                name="nome"

                required

                value="${esc(p.nome||"")}">

            </div>

            <div class="field">

              <label class="label">

                Categoria

              </label>

              <input

                class="input"

                name="cat"

                required

                value="${esc(p.cat||"")}">

            </div>

            <div class="field">

              <label class="label">

                Preço de venda

              </label>

              <input

                class="input"

                type="number"

                step="0.01"

                min="0"

                name="preco"

                required

                value="${p.preco??""}">

            </div>

            <div class="field">

              <label class="label">

                Estoque inicial

              </label>

              <input

                class="input"

                type="number"

                min="0"

                name="estoqueInicial"

