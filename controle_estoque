</head>

<body>

<div id="app"></div>

<script>

"use strict";

/* ============================================================

   PRODUTOS PADRÃO

============================================================ */

const PRODUTOS_PADRAO = [

  {id:1,nome:"Coca-Cola Zero",cat:"Bebida",preco:3.99,estoqueInicial:11},

  {id:2,nome:"YoPRO Coco e Batata Doce",cat:"Suplemento",preco:10,estoqueInicial:6},

  {id:3,nome:"YoPRO Frutas Vermelhas",cat:"Suplemento",preco:10,estoqueInicial:2},

  {id:4,nome:"YoPRO Chocolate",cat:"Suplemento",preco:10,estoqueInicial:5},

  {id:5,nome:"YoPRO Energy Boost",cat:"Suplemento",preco:10,estoqueInicial:3},

  {id:6,nome:"Monster Zero Açúcar",cat:"Energético",preco:11.99,estoqueInicial:31},

  {id:7,nome:"Monster Taurina",cat:"Energético",preco:11.99,estoqueInicial:5},

  {id:8,nome:"Monster Ultra Violet",cat:"Energético",preco:11.99,estoqueInicial:11},

  {id:9,nome:"Monster Ultra",cat:"Energético",preco:11.99,estoqueInicial:8},

  {id:10,nome:"Leão Com Gás",cat:"Bebida",preco:4.99,estoqueInicial:14},

  {id:11,nome:"Powerade Uva",cat:"Isotônico",preco:5.99,estoqueInicial:1},

  {id:12,nome:"Powerade Mix de Frutas",cat:"Isotônico",preco:5.99,estoqueInicial:5},

  {id:13,nome:"Powerade Laranja",cat:"Isotônico",preco:5.99,estoqueInicial:4},

  {id:14,nome:"Água Com Gás",cat:"Bebida",preco:2.99,estoqueInicial:13},

  {id:15,nome:"Água Cristal",cat:"Bebida",preco:2.99,estoqueInicial:16}

];

/* ============================================================

   TURNOS

============================================================ */

const CONFERENCIAS = [

  {id:"m_entrada",turno:"Manhã",tipo:"Entrada",hora:"05:00"},

  {id:"m_saida",turno:"Manhã",tipo:"Saída",hora:"11:00"},

  {id:"t_entrada",turno:"Tarde",tipo:"Entrada",hora:"11:00"},

  {id:"t_saida",turno:"Tarde",tipo:"Saída",hora:"17:00"},

  {id:"n_entrada",turno:"Noite",tipo:"Entrada",hora:"17:00"},

  {id:"n_saida",turno:"Noite",tipo:"Saída",hora:"22:00"}

];

const RESPONSAVEIS = [

  "Gabrielle",

  "Adryel",

  "Hugo"

];

/* ============================================================

   ESTADO

============================================================ */

let state = {

  modo:"recepcao",

  abaAdmin:"resumo",

  data:hoje(),

  conf:0,

  produtos:carregarProdutos(),

  dia:null,

  modal:null,

  toast:null

};

/* ============================================================

   UTILITÁRIOS

============================================================ */

function hoje(){

  const d=new Date();

  const local=new Date(

    d.getTime()-d.getTimezoneOffset()*60000

  );

  return local.toISOString().slice(0,10);

}

function dinheiro(v){

  return Number(v||0).toLocaleString(

    "pt-BR",

    {

      style:"currency",

      currency:"BRL"

    }

  );

}

function dataBR(v){

  if(!v)return"—";

  const [a,m,d]=v.split("-");

  return `${d}/${m}/${a}`;

}

function esc(v){

  return String(v??"")

    .replace(/&/g,"&amp;")

    .replace(/"/g,"&quot;")

    .replace(/</g,"&lt;")

    .replace(/>/g,"&gt;");

}

/* ============================================================

   PRODUTOS

============================================================ */

function carregarProdutos(){

  try{

    const raw=

      localStorage.getItem(

        "nowfit_cedro_produtos"

      );

    if(raw){

      const produtos=

        JSON.parse(raw);

      if(Array.isArray(produtos)){

        return produtos;

      }

    }

  }catch(e){}

  const copia=

    JSON.parse(

      JSON.stringify(PRODUTOS_PADRAO)

    );

  localStorage.setItem(

    "nowfit_cedro_produtos",

    JSON.stringify(copia)

  );

  return copia;

}

function salvarProdutos(){

  localStorage.setItem(

    "nowfit_cedro_produtos",

    JSON.stringify(state.produtos)

  );

}

/* ============================================================

   DIA

============================================================ */

function novoRegistro(){

  const produtos={};

  state.produtos.forEach(p=>{

    produtos[p.id]={

      reposicao:"",

      vendido:"",

      ajuste:null

    };

  });

  return {

    responsavel:"",

    produtos,

    finalizado:false,

    finalizadoEm:null

  };

}

function novoDia(){

  const dia={

    versao:3,

    /*

      IMPORTANTE:

      Cada dia guarda seu próprio estoque inicial.

      Alterar produtos amanhã NÃO altera dias antigos.

    */

    estoqueInicial:{},

    conferencias:[]

  };

  state.produtos.forEach(p=>{

    dia.estoqueInicial[p.id]=

      Number(p.estoqueInicial||0);

  });

  for(let i=0;i<CONFERENCIAS.length;i++){

    dia.conferencias.push(

      novoRegistro()

    );

  }

  return dia;

}

function chaveDia(){

  return "nowfit_cedro_dia:"+state.data;

}

function carregarDia(){

  try{

    const raw=

      localStorage.getItem(

        chaveDia()

      );

    if(raw){

      const dia=

        JSON.parse(raw);

      if(!dia.estoqueInicial){

        dia.estoqueInicial={};

      }

      if(!Array.isArray(dia.conferencias)){

        dia.conferencias=[];

      }

      while(

        dia.conferencias.length<

        CONFERENCIAS.length

      ){

        dia.conferencias.push(

          novoRegistro()

        );

      }

      /*

        Adiciona produtos novos sem apagar

        os produtos antigos do histórico.

      */

      state.produtos.forEach(p=>{

        if(

          dia.estoqueInicial[p.id]===

          undefined

        ){

          dia.estoqueInicial[p.id]=

            Number(p.estoqueInicial||0);

        }

        dia.conferencias.forEach(reg=>{

          if(!reg.produtos){

            reg.produtos={};

          }

          if(!reg.produtos[p.id]){

            reg.produtos[p.id]={

              reposicao:"",

              vendido:"",

              ajuste:null

            };

          }

        });

      });

      return dia;

    }

  }catch(e){}

  return novoDia();

}

function salvarDia(){

  localStorage.setItem(

    chaveDia(),

    JSON.stringify(state.dia)

  );

}

/* ============================================================

   ESTOQUE

============================================================ */

/*

  ESTA É A PARTE MAIS IMPORTANTE.

  O sistema NÃO pede para a pessoa digitar

  novamente o estoque anterior.

  Exemplo:

  Turno 1:

  anterior 20

  reposição 5

  vendido 8

  atual = 17

  Finaliza turno.

  Turno 2:

  anterior = 17 automaticamente.

  Se:

  reposição 3

  vendido 4

  atual = 16

  Finaliza.

  Turno 3:

  anterior = 16 automaticamente.

*/

function estoqueAnterior(index,pid){

  /*

    Primeiro turno:

    pega o estoque inicial salvo para aquele dia.

  */

  if(index===0){

    return Number(

      state.dia.estoqueInicial[pid]||0

    );

  }

  /*

    Qualquer turno depois do primeiro:

    pega o estoque final do turno anterior.

  */

  return estoqueFinal(

    index-1,

    pid

  );

}

function estoqueFinal(index,pid){

  const anterior=

    estoqueAnterior(

      index,

      pid

    );

  const registro=

    state.dia.conferencias[index];

  const item=

    registro?.produtos?.[pid]||{};

  /*

    AJUSTE MANUAL

    Se alguém encontrou fisicamente uma quantidade

    diferente da calculada, pode usar o campo de ajuste.

    Esse valor passa a ser o estoque final.

  */

  if(

    item.ajuste!==null &&

    item.ajuste!==undefined &&

    item.ajuste!==""

  ){

    return Number(item.ajuste)||0;

  }

  const reposicao=

    Number(item.reposicao)||0;

  const vendido=

    Number(item.vendido)||0;

  return (

    anterior+

    reposicao-

    vendido

  );

}

/* ============================================================

   FINALIZAR TURNO

============================================================ */

function finalizarTurno(){

  const index=state.conf;

  const registro=

    state.dia.conferencias[index];

  if(!registro.responsavel){

    toast(

      "Selecione o responsável antes de finalizar o turno.",

      true

    );

    return;

  }

  /*

    Marca o turno como finalizado.

  */

  registro.finalizado=true;

  registro.finalizadoEm=

    new Date().toISOString();

  /*

    Salva primeiro.

    Assim o próximo turno já consegue

    enxergar os valores calculados.

  */

  salvarDia();

  /*

    Se ainda houver próximo turno,

    abre automaticamente.

  */

  if(index<CONFERENCIAS.length-1){

    state.conf=index+1;

    toast(

      "Turno finalizado! O estoque foi transferido para o próximo turno."

    );

    render();

    /*

      Rola para o topo para a pessoa já começar

      o próximo turno.

    */

    window.scrollTo({

      top:0,

      behavior:"smooth"

    });

  }else{

    /*

      Último turno do dia.

    */

    toast(

      "Último turno finalizado! Dia encerrado."

    );

    render();

  }

}

/* ============================================================

   ALTERAR CAMPOS

============================================================ */

function alterarCampo(

  pid,

  campo,

  valor

){

  const registro=

    state.dia.conferencias[state.conf];

  if(!registro.produtos[pid]){

    registro.produtos[pid]={

      reposicao:"",

      vendido:"",

      ajuste:null

    };

  }

  registro.produtos[pid][campo]=valor;

  /*

    Salva imediatamente.

  */

  salvarDia();

  render();

}

function alterarResponsavel(valor){

  state.dia

    .conferencias[state.conf]

    .responsavel=valor;

  salvarDia();

}

/* ============================================================

   AJUSTE MANUAL

============================================================ */

function ajustarEstoque(pid,valor){

  const registro=

    state.dia.conferencias[state.conf];

  if(!registro.produtos[pid]){

    registro.produtos[pid]={

      reposicao:"",

      vendido:"",

      ajuste:null

    };

  }

  if(valor===""){

    registro.produtos[pid].ajuste=null;

  }else{

    registro.produtos[pid].ajuste=

      Number(valor);

  }

  salvarDia();

  render();

}

/* ============================================================

   TOAST

============================================================ */

function toast(msg,erro=false){

  state.toast={

    msg,

    erro

  };

  render();

  setTimeout(()=>{

    state.toast=null;

    render();

  },3000);

}

/* ============================================================

   WHATSAPP

============================================================ */

function textoConferencia(){

  const conf=

    CONFERENCIAS[state.conf];

  const registro=

    state.dia.conferencias[state.conf];

  let totalQtd=0;

  let totalFat=0;

  let linhas="";

  state.produtos.forEach(p=>{

    const item=

      registro.produtos[p.id]||{};

    const qtd=

      Number(item.vendido)||0;

    if(qtd>0){

      const fat=

        qtd*Number(p.preco||0);

      totalQtd+=qtd;

      totalFat+=fat;

      linhas+=

        `• ${p.nome}: ${qtd}x — ${dinheiro(fat)}\n`;

    }

  });

  let msg=

    `*NOWFIT CEDRO — CONFERÊNCIA*\n`+

    `*${conf.turno} — ${conf.tipo}*\n`+

    `Data: ${dataBR(state.data)}\n`+

    `Horário: ${conf.hora}\n`+

    `Responsável: ${registro.responsavel||"—"}\n\n`+

    `*VENDAS*\n`+

    (linhas||"Nenhuma venda registrada.\n")+

    `\n*Itens vendidos:* ${totalQtd}\n`+

    `*Faturamento:* ${dinheiro(totalFat)}`;

  return msg;

}

function enviarWhatsApp(){

  const msg=

    textoConferencia();

  window.open(

    "https://api.whatsapp.com/send?text="+

    encodeURIComponent(msg),

    "_blank"

  );

}

function textoDia(){

  let totalQtd=0;

  let totalFat=0;

  let blocos="";

  CONFERENCIAS.forEach(

    (conf,index)=>{

      const registro=

        state.dia.conferencias[index];

      if(!registro?.finalizado){

        return;

      }

      let linhas="";

      let qtdTurno=0;

      let fatTurno=0;

      state.produtos.forEach(p=>{

        const item=

          registro.produtos[p.id]||{};

        const qtd=

          Number(item.vendido)||0;

        if(qtd>0){

          const fat=

            qtd*Number(p.preco||0);

          qtdTurno+=qtd;

          fatTurno+=fat;

          linhas+=

            `• ${p.nome}: ${qtd}x\n`;

        }

      });

      totalQtd+=qtdTurno;

      totalFat+=fatTurno;

      blocos+=

        `\n*${conf.turno} — ${conf.tipo}*\n`+

        `Responsável: ${registro.responsavel||"—"}\n`+

