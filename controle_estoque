  `;

}

/* ============================================================

   SALVAR PRODUTO

============================================================ */

function salvarProduto(e){

  e.preventDefault();

  const form=e.target;

  const id=

    form.id.value

    ?Number(form.id.value)

    :Date.now();

  const nome=

    form.nome.value.trim();

  const cat=

    form.cat.value.trim();

  const preco=

    Number(form.preco.value)||0;

  const estoqueInicial=

    Number(form.estoqueInicial.value)||0;

  if(!nome||!cat){

    toast(

      "Preencha nome e categoria.",

      true

    );

    return;

  }

  const produto={

    id,

    nome,

    cat,

    preco,

    estoqueInicial

  };

  const index=

    state.produtos.findIndex(

      p=>p.id===id

    );

  if(index>=0){

    state.produtos[index]=produto;

  }else{

    state.produtos.push(produto);

    /*

      Se for produto novo, adiciona ao dia atual.

    */

    if(

      state.dia.estoqueInicial[id]===

      undefined

    ){

      state.dia.estoqueInicial[id]=

        estoqueInicial;

    }

    state.dia.conferencias.forEach(

      reg=>{

        if(!reg.produtos){

          reg.produtos={};

        }

        reg.produtos[id]={

          reposicao:"",

          vendido:"",

          ajuste:null

        };

      }

    );

    salvarDia();

  }

  salvarProdutos();

  state.modal=null;

  toast(

    "Produto salvo com sucesso!"

  );

  render();

}

/* ============================================================

   EXCLUIR PRODUTO

============================================================ */

function excluirProduto(id){

  const produto=

    state.produtos.find(

      p=>p.id===id

    );

  if(!produto)return;

  const confirmar=

    confirm(

      `Excluir "${produto.nome}" do catálogo?\n\n`+

      `Os registros históricos não serão apagados.`

    );

  if(!confirmar)return;

  state.produtos=

    state.produtos.filter(

      p=>p.id!==id

    );

  salvarProdutos();

  toast(

    "Produto removido do catálogo."

  );

  render();

}

/* ============================================================

   REABRIR TURNO

============================================================ */

function reabrirTurno(){

  const ok=

    confirm(

      "Deseja reabrir este turno para edição?"

    );

  if(!ok)return;

  state.dia

    .conferencias[state.conf]

    .finalizado=false;

  state.dia

    .conferencias[state.conf]

    .finalizadoEm=null;

  salvarDia();

  toast(

    "Turno reaberto."

  );

  render();

}

/* ============================================================

   EVENTOS

============================================================ */

function bind(){

  /* Modo recepção */

  document

    .querySelectorAll(

      '[data-action="recepcao"]'

    )

    .forEach(btn=>{

      btn.onclick=()=>{

        state.modo="recepcao";

        render();

      };

    });

  /* Modo administrativo */

  document

    .querySelectorAll(

      '[data-action="admin"]'

    )

    .forEach(btn=>{

      btn.onclick=()=>{

        state.modo="administrativo";

        render();

      };

    });

  /* Data recepção */

  const data=

    document.getElementById("data");

  if(data){

    data.onchange=e=>{

      state.data=e.target.value;

      state.conf=0;

      state.dia=

        carregarDia();

      render();

    };

  }

  /* Data admin */

  const dataAdmin=

    document.getElementById("data-admin");

  if(dataAdmin){

    dataAdmin.onchange=e=>{

      state.data=

        e.target.value;

      state.dia=

        carregarDia();

      render();

    };

  }

  /* Turnos */

  document

    .querySelectorAll(

      "[data-conf]"

    )

    .forEach(btn=>{

      btn.onclick=()=>{

        state.conf=

          Number(

            btn.dataset.conf

          );

        render();

      };

    });

  /* Responsável */

  const responsavel=

    document.getElementById(

      "responsavel"

    );

  if(responsavel){

    responsavel.onchange=e=>{

      alterarResponsavel(

        e.target.value

      );

    };

  }

  /* Reposição / vendido */

  document

    .querySelectorAll(

      "[data-prod]"

    )

    .forEach(input=>{

      input.onchange=e=>{

        alterarCampo(

          Number(

            e.target.dataset.prod

          ),

          e.target.dataset.campo,

          e.target.value

        );

      };

    });

  /* Ajuste manual */

  document

    .querySelectorAll(

      "[data-ajuste]"

    )

    .forEach(input=>{

      input.onchange=e=>{

        ajustarEstoque(

          Number(

            e.target.dataset.ajuste

          ),

          e.target.value

        );

      };

    });

  /* Finalizar */

  const finalizar=

    document.getElementById(

      "finalizar"

    );

  if(finalizar){

    finalizar.onclick=

      finalizarTurno;

  }

  /* Reabrir */

  const reabrir=

    document.getElementById(

      "reabrir"

    );

  if(reabrir){

    reabrir.onclick=

      reabrirTurno;

  }

  /* WhatsApp */

  const whats=

    document.getElementById(

      "whatsapp"

    );

  if(whats){

    whats.onclick=

      enviarWhatsApp;

  }

  const whatsDia=

    document.getElementById(

      "whatsapp-dia"

    );

  if(whatsDia){

    whatsDia.onclick=

      enviarDia;

  }

  const whatsDiaAdmin=

    document.getElementById(

      "whatsapp-dia-admin"

    );

  if(whatsDiaAdmin){

    whatsDiaAdmin.onclick=

      enviarDia;

  }

  /* Abas admin */

  document

    .querySelectorAll(

      "[data-aba]"

    )

    .forEach(btn=>{

      btn.onclick=()=>{

        state.abaAdmin=

          btn.dataset.aba;

        render();

      };

    });

  /* Novo produto */

  const novo=

    document.getElementById(

      "novo-produto"

    );

  if(novo){

    novo.onclick=()=>{

      state.modal={

        id:null,

        nome:"",

        cat:"",

        preco:"",

        estoqueInicial:0

      };

      render();

    };

  }

  /* Editar produto */

  document

    .querySelectorAll(

      "[data-editar]"

    )

    .forEach(btn=>{

      btn.onclick=()=>{

        const produto=

          state.produtos.find(

            p=>p.id===

              Number(

                btn.dataset.editar

              )

          );

        if(produto){

          state.modal={

            ...produto

          };

          render();

        }

      };

    });

  /* Excluir */

  document

    .querySelectorAll(

      "[data-excluir]"

    )

    .forEach(btn=>{

      btn.onclick=()=>{

        excluirProduto(

          Number(

            btn.dataset.excluir

          )

        );

      };

    });

  /* Form produto */

  const form=

    document.getElementById(

      "form-produto"

    );

  if(form){

    form.onsubmit=

      salvarProduto;

  }

  /* Fechar modal */

  const fechar=

    document.getElementById(

      "fechar-modal"

    );

  if(fechar){

    fechar.onclick=()=>{

      state.modal=null;

      render();

    };

  }

  /* Histórico */

  document

    .querySelectorAll(

      "[data-historico]"

    )

    .forEach(btn=>{

      btn.onclick=()=>{

        state.data=

          btn.dataset.historico;

        state.conf=0;

        state.dia=

          carregarDia();

        state.modo="recepcao";

        render();

      };

    });

}

/* ============================================================

   INICIALIZAÇÃO

============================================================ */

state.dia=

  carregarDia();

render();

</script>

