/* ============================================================

   RESUMO ADMINISTRATIVO

============================================================ */

function calcularResumo(){

  let faturamento=0;

  let vendidos=0;

  let estoque=0;

  const porTurno={

    Manhã:0,

    Tarde:0,

    Noite:0

  };

  const porProduto={};

  state.produtos.forEach(p=>{

    porProduto[p.id]={

      nome:p.nome,

      qtd:0,

      fat:0

    };

    let final=Number(

      state.dia.estoqueInicial[p.id]||0

    );

    CONFERENCIAS.forEach(

      (conf,index)=>{

        const registro=

          state.dia.conferencias[index];

        const item=

          registro?.produtos?.[p.id]||{};

        const qtd=

          Number(item.vendido)||0;

        const fat=

          qtd*Number(p.preco||0);

        faturamento+=fat;

        vendidos+=qtd;

        porTurno[conf.turno]+=fat;

        porProduto[p.id].qtd+=qtd;

        porProduto[p.id].fat+=fat;

        if(

          item.ajuste!==null &&

          item.ajuste!==undefined &&

          item.ajuste!==""

        ){

          final=

            Number(item.ajuste)||0;

        }else{

          final=

            final+

            (Number(item.reposicao)||0)-

            qtd;

        }

      }

    );

    estoque+=final;

  });

  return{

    faturamento,

    vendidos,

    estoque,

    porTurno,

    porProduto

  };

}

/* ============================================================

   HISTÓRICO

============================================================ */

function obterHistorico(){

  const lista=[];

  for(

    let i=0;

    i<localStorage.length;

    i++

  ){

    const key=

      localStorage.key(i);

    if(

      !key ||

      !key.startsWith(

        "nowfit_cedro_dia:"

      )

    ){

      continue;

    }

    const data=

      key.replace(

        "nowfit_cedro_dia:",

        ""

      );

    try{

      const dia=

        JSON.parse(

          localStorage.getItem(key)

        );

      let conf=0;

      let fat=0;

      (dia.conferencias||[])

        .forEach(reg=>{

          if(reg?.finalizado){

            conf++;

            state.produtos.forEach(p=>{

              const item=

                reg.produtos?.[p.id]||{};

              fat+=

                (Number(item.vendido)||0)*

                Number(p.preco||0);

            });

          }

        });

      lista.push({

        data,

        conf,

        fat

      });

    }catch(e){}

  }

  return lista

    .sort(

      (a,b)=>

        b.data.localeCompare(a.data)

    )

    .slice(0,30);

}

